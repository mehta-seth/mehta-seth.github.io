---
// src/components/Verses.astro
//
// Verse-and-translation rows for a hymn in an HML note, with a toggle that
// switches the original between romanized and Devanagari.
//
// >= 1280px: two columns, one row per line, so each line of the original
// starts level with its English (rows share a baseline; a wrapped English
// line makes its row taller). The English column starts on the page's
// centre line: the note shell is a centred box inset 6rem left / 2rem right,
// so from the content box's left edge the centre is at 50% - 2rem.
// < 1280px: verse by verse, the four lines of the original and then their
// English (CSS order; the DOM stays line, English, line, English).
//
// Toggle: two radio buttons and a :has() rule, no JavaScript. In the
// two-column layout both scripts share a cell and only visibility swaps, so
// nothing moves; stacked, the hidden script is display:none. Without :has()
// the toggle is hidden and the romanized text shows.
//
// Usage (injected by the /learn/ route):
//   <Verses id="..." verses={...} credit={...} />

interface Line {
  /** Romanized Sanskrit. */
  roman: string;
  /** The same line in Devanagari. */
  deva: string;
  /** English rendering of the line. */
  meaning: string;
}

interface Props {
  /** Short key, unique on the page; namespaces the toggle's radio group. */
  id: string;
  /** The verses, each an ordered list of its lines. */
  verses: Line[][];
  /** Optional closing line, set just above the footer rule. */
  credit?: string;
}

const { id, verses, credit } = Astro.props;
const group = `verses-${id}`;
---

<div class="verses">
  <fieldset class="verses__toggle">
    <legend class="verses__legend">Show the Sanskrit in</legend>
    <div class="verses__options">
      <input
        class="verses__radio"
        type="radio"
        name={group}
        id={`${group}-roman`}
        value="roman"
        checked
      />
      <label class="verses__option" for={`${group}-roman`}>Romanized</label>
      <input
        class="verses__radio"
        type="radio"
        name={group}
        id={`${group}-deva`}
        value="deva"
      />
      <label class="verses__option verses__option--deva" for={`${group}-deva`} lang="sa">देवनागरी</label>
    </div>
  </fieldset>

  <ol class="verses__list">
    {verses.map((verse) => (
      <li class="verse">
        {verse.map((line, i) => (
          <>
            <div class="verse__line">
              <span class="verse__roman" lang="sa-Latn">{line.roman}</span>
              <span class="verse__deva" lang="sa">{line.deva}</span>
            </div>
            <div class:list={['verse__gloss', { 'verse__gloss--first': i === 0 }]}>
              {line.meaning}
            </div>
          </>
        ))}
      </li>
    ))}
  </ol>

  {credit && <p class="verses__credit">{credit}</p>}
</div>

<style>
  /* VISUAL TUNABLES, on .verses:
       --verses-col-gap        gutter between the original and the centre line
       --verses-verse-gap      space between verses
       --verses-lh             line height of the original and the English
       --verses-meaning-scale  English size relative to the original
       --verses-deva-scale     Devanagari size relative to the romanized line;
                               the line box keeps the same height at any
                               value (see .verse__deva) */
  .verses {
    --verses-col-gap: 3rem;
    --verses-verse-gap: 2.75rem;
    --verses-lh: 1.6;
    --verses-meaning-scale: 0.92;
    --verses-deva-scale: 1.04;
    max-width: var(--note-measure, 50rem);
    margin: 0.25rem 0 0;
  }

  /* ─── Toggle ─────────────────────────────────────────────────────── */
  .verses__toggle {
    border: 0;
    margin: 0 0 2.5rem;
    padding: 0;
    min-width: 0;
  }
  .verses__legend {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .verses__options {
    position: relative;
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .verses__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .verses__option {
    padding: 0.3rem 0.95rem;
    border-radius: 999px;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .verses__option:hover {
    color: var(--text);
  }
  .verses__option--deva {
    font-family: 'HML Devanagari', 'Newsreader', serif;
  }
  .verses__radio:checked + .verses__option {
    color: var(--accent);
    background-color: var(--bg-elevated);
    box-shadow: 0 0 0 1px var(--border);
    cursor: default;
  }
  .verses__radio:focus-visible + .verses__option {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ─── Verses ─────────────────────────────────────────────────────── */
  .verses__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .verse {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    line-height: var(--verses-lh);
  }
  .verse + .verse {
    margin-top: var(--verses-verse-gap);
  }

  .verse__line,
  .verse__gloss {
    padding-left: 1.25em;
    text-indent: -1.25em; /* hanging indent for a wrapped line */
  }
  .verse__line {
    display: grid;
    align-items: baseline;
    color: var(--text);
  }
  .verse__roman,
  .verse__deva {
    grid-area: 1 / 1;
  }
  .verse__deva {
    display: none;
    font-family: 'HML Devanagari', 'Newsreader', serif;
    font-size: calc(var(--verses-deva-scale) * 1em);
    line-height: calc(var(--verses-lh) / var(--verses-deva-scale));
  }
  .verse__gloss {
    order: 1; /* stacked: the whole verse, then its English */
    color: var(--text-muted);
    font-size: calc(var(--verses-meaning-scale) * 1em);
  }
  .verse__gloss--first {
    margin-top: 0.85rem;
  }

  @media (min-width: 1280px) {
    .verses {
      max-width: none;
    }
    .verse {
      grid-template-columns:
        calc(50% - 2rem - var(--verses-col-gap))
        calc(50% - 2rem);
      column-gap: var(--verses-col-gap);
      align-items: baseline;
    }
    .verse__gloss {
      order: 0;
    }
    .verse__gloss--first {
      margin-top: 0;
    }
  }

  /* ─── Script switch ──────────────────────────────────────────────── */
  .verses:has(.verses__radio[value='deva']:checked) .verse__roman {
    display: none;
  }
  .verses:has(.verses__radio[value='deva']:checked) .verse__deva {
    display: block;
  }
  @media (min-width: 1280px) {
    .verse__deva {
      display: block;
      visibility: hidden;
    }
    .verses:has(.verses__radio[value='deva']:checked) .verse__roman {
      display: block;
      visibility: hidden;
    }
    .verses:has(.verses__radio[value='deva']:checked) .verse__deva {
      visibility: visible;
    }
  }
  @supports not selector(:has(*)) {
    .verses__toggle {
      display: none;
    }
  }

  /* ─── Credit ─────────────────────────────────────────────────────────
     Footer type (as "Back to top"). The negative bottom margin collapses
     with the footer's 5rem top margin, leaving 2rem above the rule. */
  .verses__credit {
    margin: 4rem 0 -3rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
