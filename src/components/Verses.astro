---
// src/components/Verses.astro
//
// A hymn or poem in an HML note, set as facing text: each verse on the left,
// its English on the right, the English starting at the centre of the page,
// the way bilingual editions of Indian classics face the original with its
// translation. A toggle above switches ONLY the left column between
// romanized Sanskrit (the default) and Devanāgarī; the English never moves.
//
// Layout
//   >= 1280px  Two columns. The English starts exactly on the page's centre
//              line and its column is as wide as the verse side, so the outer
//              margins match. The note shell is a centred border-box with a
//              6rem left / 2rem right inset, so measured from the content
//              box's left edge the centre is always at 50% - 2rem; the tracks
//              are calc()s of that (no vw, so a scrollbar can't skew it).
//              Each verse is one row: the original as a block on the left,
//              the English as a block on the right, first lines on one
//              baseline. Every English line starts on a new line (a wrap gets
//              a hanging indent), so line n of the English answers line n of
//              the verse even when it runs longer.
//   <  1280px  Stacked: the verse, then its English. Below 1280 the half-page
//              column is narrower than the longest verse line.
//
// The toggle needs no JavaScript: two native radio buttons (keyboard,
// screen-reader and form-restore behaviour come free) and one :has() rule.
// Both scripts are always in the DOM. In the two-column layout they share one
// grid cell and the inactive one is visibility:hidden, so every cell is
// already as tall as the taller script and switching moves nothing on the
// page. Stacked, a long romanized line can wrap where its Devanāgarī doesn't,
// and a shared cell would leave a blank line, so there the inactive script is
// display:none (the English below shifts a little on a tap, which the stacked
// layout makes harmless). Either way the hidden script is out of the
// accessibility tree. Browsers without :has() (pre-2023) don't see the toggle
// and read the romanized text.
//
// Credit: pass `credit` (e.g. a translation credit) and it is set as the last
// line, in the footer's small muted type, sitting just above the footer rule.
//
// Styles are scoped (unlike <Boxed>/<Ref>, whose rules live in NoteLayout's
// global block because they wrap MDX-rendered content): every element here is
// this component's own markup. The CSS (~2 KB) is bundled with the /learn/
// route, which injects the component, so it loads on note pages only.
//
// Fonts: the romanized lines and the English are Newsreader; Devanāgarī is
// 'HML Devanagari' (Tiro Devanagari Sanskrit, subset by
// scripts/refresh-fonts.mjs to the Devanāgarī actually used in src/).
//
// Usage in MDX (the component is injected by the /learn/ route):
//   import { nirvanaShatakam, TRANSLATION_CREDIT } from '../../data/nirvana-shatakam';
//   <Verses id="nirvana-shatakam" verses={nirvanaShatakam} credit={TRANSLATION_CREDIT} />

interface Line {
  /** Romanized Sanskrit. */
  roman: string;
  /** The same line in Devanāgarī. */
  deva: string;
  /** English rendering of the line. */
  meaning: string;
}

interface Props {
  /** Short key, unique on the page; namespaces the toggle's radio group. */
  id: string;
  /** The verses, each an ordered list of its lines. */
  verses: Line[][];
  /** Optional closing credit line (empty or absent: nothing is shown). */
  credit?: string;
}

const { id, verses, credit } = Astro.props;
const group = `verses-${id}`;
---

<div class="verses">
  <fieldset class="verses__toggle">
    <legend class="verses__legend">Show the Sanskrit in</legend>
    <div class="verses__options">
      <input
        class="verses__radio"
        type="radio"
        name={group}
        id={`${group}-roman`}
        value="roman"
        checked
      />
      <label class="verses__option" for={`${group}-roman`}>Romanized</label>
      <input
        class="verses__radio"
        type="radio"
        name={group}
        id={`${group}-deva`}
        value="deva"
      />
      <label class="verses__option verses__option--deva" for={`${group}-deva`} lang="sa">देवनागरी</label>
    </div>
  </fieldset>

  <ol class="verses__list">
    {verses.map((verse) => (
      <li class="verse">
        <div class="verse__original">
          {verse.map((line) => (
            <div class="verse__line">
              <span class="verse__roman" lang="sa-Latn">{line.roman}</span>
              <span class="verse__deva" lang="sa">{line.deva}</span>
            </div>
          ))}
        </div>
        <div class="verse__english">
          {verse.map((line) => (
            <div class="verse__gloss">{line.meaning}</div>
          ))}
        </div>
      </li>
    ))}
  </ol>

  {credit && <p class="verses__credit">{credit}</p>}
</div>

<style>
  /* VISUAL TUNABLES — all in one place, on .verses:
       --verses-col-gap        gutter between the verse and the centre line
       --verses-verse-gap      air between one verse and the next
       --verses-lh             line height of verse lines and the English
       --verses-meaning-scale  English size relative to the verse: one step
                               down, so the verse leads
       --verses-deva-scale     Devanāgarī size relative to the romanized
                               line. Set by eye in a real render: at the same
                               nominal size Tiro reads smaller and lighter
                               than the romanized line, so it sits a step UP.
                               The line box stays the same height (see
                               .verse__deva), so this costs no layout. */
  .verses {
    --verses-col-gap: 3rem;
    --verses-verse-gap: 2.75rem;
    --verses-lh: 1.6;
    --verses-meaning-scale: 0.92;
    --verses-deva-scale: 1.04;
    max-width: var(--note-measure, 50rem);
    margin: 0.25rem 0 0;
  }

  /* ─── Toggle ──────────────────────────────────────────────────────
     A quiet two-option pill in the site's own tokens: hairline border,
     muted options, the chosen one lifted onto --bg-elevated in the accent.
     The radios are visually hidden but stay focusable; the focus ring is
     drawn on the label next to the focused radio. */
  .verses__toggle {
    border: 0;
    margin: 0 0 2.5rem;
    padding: 0;
    min-width: 0;
  }
  .verses__legend {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .verses__options {
    position: relative;
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .verses__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .verses__option {
    padding: 0.3rem 0.95rem;
    border-radius: 999px;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .verses__option:hover {
    color: var(--text);
  }
  .verses__option--deva {
    font-family: 'HML Devanagari', 'Newsreader', serif;
  }
  .verses__radio:checked + .verses__option {
    color: var(--accent);
    background-color: var(--bg-elevated);
    box-shadow: 0 0 0 1px var(--border);
    cursor: default;
  }
  .verses__radio:focus-visible + .verses__option {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ─── Verses ──────────────────────────────────────────────────────
     .note__body styles ol/li/p for prose; these scoped rules (higher
     specificity) reset that here. */
  .verses__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .verse {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    line-height: var(--verses-lh);
  }
  .verse + .verse {
    margin-top: var(--verses-verse-gap);
  }

  .verse__line,
  .verse__gloss {
    padding-left: 1.25em;
    text-indent: -1.25em; /* hanging indent for a wrapped line */
  }
  .verse__line {
    display: grid;
    align-items: baseline; /* both scripts on one baseline */
    color: var(--text);
  }
  .verse__roman,
  .verse__deva {
    grid-area: 1 / 1; /* both scripts in one cell */
  }
  .verse__deva {
    display: none; /* stacked: the hidden script takes no space */
    font-family: 'HML Devanagari', 'Newsreader', serif;
    font-size: calc(var(--verses-deva-scale) * 1em);
    /* Same line-box height as the romanized line at any scale. */
    line-height: calc(var(--verses-lh) / var(--verses-deva-scale));
  }
  .verse__english {
    margin-top: 0.85rem; /* stacked: a little air between verse and English */
    color: var(--text-muted);
    font-size: calc(var(--verses-meaning-scale) * 1em);
  }

  @media (min-width: 1280px) {
    .verses {
      max-width: none; /* span the content box, so 50% is the page centre */
    }
    .verse {
      grid-template-columns:
        calc(50% - 2rem - var(--verses-col-gap))
        calc(50% - 2rem);
      column-gap: var(--verses-col-gap);
      align-items: baseline;
    }
    .verse__english {
      margin-top: 0;
    }
  }

  /* ─── The switch ─────────────────────────────────────────────────
     Stacked: swap with display. Two columns: both scripts keep their box
     and only visibility swaps, so nothing on the page moves. */
  .verses:has(.verses__radio[value='deva']:checked) .verse__roman {
    display: none;
  }
  .verses:has(.verses__radio[value='deva']:checked) .verse__deva {
    display: block;
  }
  @media (min-width: 1280px) {
    .verse__deva {
      display: block;
      visibility: hidden;
    }
    .verses:has(.verses__radio[value='deva']:checked) .verse__roman {
      display: block;
      visibility: hidden;
    }
    .verses:has(.verses__radio[value='deva']:checked) .verse__deva {
      visibility: visible;
    }
  }
  @supports not selector(:has(*)) {
    .verses__toggle {
      display: none;
    }
  }

  /* ─── Credit ─────────────────────────────────────────────────────
     The footer's own small muted type (like "Back to top"). The note
     footer sits 5rem below the body; the negative bottom margin collapses
     with that, so the credit sits 2rem above the rule, mirroring the 2rem
     between the rule and "Back to top". */
  .verses__credit {
    margin: 4rem 0 -3rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--text-muted);
  }
</style>
