---
// src/layouts/NoteLayout.astro
//
// Layout for a "help me learn" note (HML). Responsibilities as of Phase 2:
//   - the same chrome as the essay/cities pages (wordmark top-left, fixed
//     theme toggle top-right), reusing BaseLayout, Wordmark, ThemeToggle
//     unchanged;
//   - a wider, LEFT-ANCHORED content column (not centred like the essay);
//   - the "help me learn" kicker, now set in the handwritten face
//     ('HML Script', a subset of Dawning of a New Day), sitting above a
//     bold topic title;
//   - the topic title rendered from `titleDisplay` via KaTeX, so the σ in
//     "σ-Algebras" is a real math glyph rather than a Unicode character the
//     Newsreader subset can't draw;
//   - build-time KaTeX for `$…$` (inline) and `$$…$$` (display) maths,
//     including the narrow-screen wide-equation handling in the global
//     block below;
//   - the note-body typography.
//
// Arriving in later phases (hooks/space reserved and commented here):
//   - Phase 3: the collapsible table of contents (hamburger in the left
//     gutter), the natural (non-rectangular) highlight box, and
//     cross-reference links.
//   - Phase 4: figures / lightbox for notes.
//
// The essay layout is deliberately NOT touched — this is a separate layout
// with its own widths and its own body namespace (.note__body). Note also
// that this file writes the serif stack out literally and never references
// var(--font-serif): that custom property is undefined project-wide and
// survives in EssayLayout only by inheritance, so it is not carried here.

import BaseLayout from './BaseLayout.astro';
import Wordmark from '@/components/Wordmark.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import NoteToc from '@/components/NoteToc.astro';
import type { MarkdownHeading } from 'astro';
import katex from 'katex';
// Self-host KaTeX's stylesheet through the build. Importing it HERE — in
// NoteLayout, the only layout that renders maths — makes Astro bundle the
// CSS and rewrite its font url()s to hashed /_astro/ assets, and emit the
// <link> on note pages ONLY. The home, essay, and cities pages never load
// it. Do not move this to a global stylesheet, and do not pull the KaTeX
// fonts from a CDN — the whole point is a self-hosted, offline-correct,
// pixel-identical render on every device.
import 'katex/dist/katex.min.css';

interface Props {
  /** Plain-text title — tab, OG, SEO, and the Phase-1 H1. */
  title: string;
  /** Optional math-bearing display title for the H1, rendered via KaTeX. */
  titleDisplay?: string;
  /** One-line SEO description. Not displayed. */
  summary?: string;
  date: Date;
  updated?: Date;
  /** Heading tree from render(); the collapsible ToC is built from its H2s. */
  headings: MarkdownHeading[];
  /** Per-note OG image; falls back to the site default in BaseLayout. */
  cover?: string;
}

// `titleDisplay` is consumed (rendered into the H1 below). `headings` is now
// consumed too (Phase 3): the collapsible ToC is built from the note's H2s.
const { title, titleDisplay, summary, date, updated, headings, cover } =
  Astro.props;

// Gate the collapsible ToC on H2 presence — the same rule as the essay
// layout's hasToc. A note with no H2s shows no hamburger at all (NoteToc
// self-guards too, but gating here keeps the button out of the DOM entirely).
const hasToc = headings.some((h) => h.depth === 2);

const stamp = updated ?? date;
const formattedDate = stamp.toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});
const isoDate = stamp.toISOString();
const dateLabel = updated ? 'Updated' : 'Published';

// Browser-tab title mirrors the essay convention.
const headTitle = `${title} — Adit Mehta`;
// Prefer the author's summary as the meta description; fall back to a
// substantive default so the SEO snippet is never thin.
const headDescription = summary
  ? summary
  : `${title}: an intuitive, one-page explanation. A help-me-learn note by Adit Mehta.`;

// Render the display title for the H1. `titleDisplay` may embed `$…$` maths
// (e.g. "$\sigma$-Algebras"): split on the math spans, run KaTeX on each,
// and leave the text segments as escaped Newsreader. The result is placed
// into the H1 via set:html. When `titleDisplay` is absent, the H1 falls
// back to the plain `title` (rendered as ordinary text, no set:html).
// throwOnError:false mirrors the body pipeline — a bad symbol shows as red
// text rather than failing the build; htmlAndMathml gives screen readers
// real maths in the heading too.
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
function renderTitleDisplay(s: string): string {
  return s
    .split(/(\$[^$]*\$)/g)
    .map((seg) =>
      seg.length >= 2 && seg.startsWith('$') && seg.endsWith('$')
        ? katex.renderToString(seg.slice(1, -1), {
            throwOnError: false,
            output: 'htmlAndMathml',
          })
        : escapeHtml(seg),
    )
    .join('');
}
const titleHtml = titleDisplay ? renderTitleDisplay(titleDisplay) : null;
---

<BaseLayout
  title={headTitle}
  description={headDescription}
  ogType="article"
  ogImage={cover}
>
  <ThemeToggle />

  {/* Chrome — wordmark top-left; the fixed theme toggle floats over the
      right from global.css. padding-right on the header keeps the
      wordmark clear of the toggle on narrow viewports, same as the essay
      and cities headers. */}
  <header class="note-header" id="top">
    <Wordmark href="/" size="small" />
  </header>

  <div class="note-shell">
    <article class="note">
      {/* Collapsible ToC (Phase 3). The hamburger lives in the left gutter
          on desktop (pulled out via absolute positioning against the
          position:relative note-head) and in-flow above the kicker on
          mobile; the drawer/scrim/script are owned by NoteToc. Rendered only
          when the note has H2s, so nothing reflows on a note without them. */}
      <header class="note-head">
        {hasToc && <NoteToc headings={headings} />}
        {/* Kicker — constant on every note. Set in the handwritten face
            ('HML Script', a hard subset of Dawning of a New Day), faint, so
            it reads as a series eyebrow above the topic title. It is the one
            display accent unique to HML (§1.2); the rest of the page stays
            in the system faces. It is a <p>, not a heading, so it never
            competes with the H1 for SEO. */}
        <p class="note-kicker">help me learn</p>
        {/* Topic title = the page's H1 (keyword-bearing). When a
            `titleDisplay` is set, its `$…$` maths is rendered via KaTeX and
            injected as HTML (that is how the σ becomes a real glyph);
            otherwise the plain `title` text is used. `title` (plain ASCII)
            still drives the browser tab, OG card, home list, and SEO. */}
        {titleHtml
          ? <h1 class="note-title" set:html={titleHtml} />
          : <h1 class="note-title">{title}</h1>}
        <p class="note-date">
          <span class="note-date__label">{dateLabel}</span>
          {' '}
          <time datetime={isoDate}>{formattedDate}</time>
        </p>
      </header>

      {/* MDX body. Flowing prose is capped at a readable measure; wide
          elements (equations, highlight boxes, figures — later phases)
          break out toward the full column width. */}
      <div class="note__body">
        <slot />
      </div>

      <footer class="note-foot">
        <a href="#top" class="note-backtotop">↑ Back to top</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  /* ─── Chrome ──────────────────────────────────────────────────────
     Identical to EssayLayout's .essay-header (80rem centred box, 1.5rem
     left padding, 4.5rem right to clear the fixed toggle). Matching the
     rule exactly means the wordmark lands in the same position, and at
     the same size, as on the essay — at every viewport width. */
  .note-header {
    display: flex;
    align-items: baseline;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 0;
    padding-right: 4.5rem;
  }

  /* ─── Shell + article ─────────────────────────────────────────────
     Same 80rem centred box as the header, so the whole page sits where
     the essay does: a real left margin on wide screens, not hugging the
     edge. The note CONTENT is then indented ~4.5rem past the wordmark by
     the shell's left padding (1.5rem wordmark inset + 4.5rem gutter =
     6rem content inset), which also reserves room for the collapsible-ToC
     hamburger (Phase 3). The reading margin lands at roughly half the
     essay's across normal desktop widths — these are explainers, so they
     use more of the page while still reading comfortably. The space this
     leaves on the RIGHT is deliberate: figures and charts go there
     (Phase 4).

     Width knobs on .note:
       --note-measure  readable prose width (flowing text is capped here)
       --note-wide     breakout width for figures / equations / boxes,
                       reaching into the right-hand space
     Both are one-line tunables. */
  .note-shell {
    max-width: 80rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 8rem;   /* mobile: content aligns with wordmark */
  }
  .note {
    --note-measure: 50rem;
    --note-wide: 66rem;
  }

  @media (min-width: 1024px) {
    /* Content indents to a 6rem left inset (4.5rem past the 1.5rem
       wordmark inset). The right padding keeps a small gutter before the
       page edge; the figure space is what's left between the ~50rem prose
       and the ~72rem content box. */
    .note-shell { padding: 3.5rem 2rem 9rem 6rem; }
  }

  /* ─── Note head ───────────────────────────────────────────────────
     position: relative so the collapsible-ToC hamburger (NoteToc) can be
     absolutely positioned into the left gutter on desktop without shifting
     the title block. */
  .note-head {
    position: relative;
    max-width: var(--note-measure);
    margin-bottom: 2.5rem;
  }
  .note-kicker {
    /* Handwritten series eyebrow — the one sanctioned display accent unique
       to HML (§1.2, and the "characterful" signature of §1.6). Dawning of a
       New Day is single-weight with a thin stroke that reads faint on the
       dark (default) theme, so it is sized up from the Phase-1 placeholder
       and set in the warm accent for presence. Contrast was never the
       problem — muted already clears WCAG AA (~6:1 dark, ~5.6:1 light) — so
       the size bump does the real work; accent adds punch in dark (~8:1) and
       is a wash in light. No font-style: italic (the face is already a
       hand). Stays below the note title at every width. VISUAL TUNABLES:
       the size clamp, colour, letter-spacing. */
    font-family: 'HML Script', cursive;
    font-size: clamp(1.75rem, 1.45rem + 1.1vw, 2.4rem);
    color: var(--accent);
    letter-spacing: 0.02em;
    line-height: 1.15;
    margin: 0 0 0.4rem 0;
  }
  .note-title {
    font-family: 'Newsreader', 'Charter', 'Georgia', serif;
    font-size: clamp(2.25rem, 1.85rem + 1.9vw, 3.25rem); /* ~36→52 */
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    margin: 0 0 0.75rem 0;
  }
  /* The σ in the title is injected as KaTeX HTML via set:html, which does
     NOT carry Astro's scope attribute — so it is reached with :global.
     KaTeX sizes inline maths at 1.21em by default, which reads a shade too
     large next to the Newsreader letters in the H1; 1em brings the glyph
     back to the size of the surrounding text. VISUAL TUNABLE: if the sigma
     sits a hair high or low against "-Algebras", nudge vertical-align here
     (left at the natural baseline for now). */
  .note-title :global(.katex) {
    font-size: 1em;
  }
  .note-date {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0;
  }
  .note-date__label {
    font-style: italic;
  }

  /* ─── Footer ──────────────────────────────────────────────────────*/
  .note-foot {
    max-width: var(--note-measure);
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .note-backtotop {
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .note-backtotop:hover,
  .note-backtotop:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>

<style is:global>
  /* ─── Note body typography (global because MDX-rendered) ───────────
     Scoped styles don't reach into <Content /> output, so the body rules
     live here, namespaced under .note__body so they never touch the home,
     cities, or essay pages.

     Two-tier width: flowing PROSE (paragraphs, headings, lists, quotes) is
     capped at the readable measure by the rule below, and display equations
     are capped at the same measure (see the display-maths block further
     down), so text and maths share one comfortable column. The wider
     breakout column (--note-wide) and the deliberate right-hand space are
     reserved for figures, charts, and highlight boxes in later phases — not
     for equations. */
  .note__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Cap flowing prose to the readable measure (inherited from .note). */
  .note__body > p,
  .note__body > ul,
  .note__body > ol,
  .note__body > blockquote,
  .note__body > h2,
  .note__body > h3 {
    max-width: var(--note-measure);
  }

  .note__body p {
    margin: 0 0 1.4em 0;
  }

  /* Headings inherit family/weight/size from the global h2/h3 rules in
     global.css; only rhythm and line-height are tuned here. */
  .note__body h2 {
    margin: 2.5em 0 0.6em;
    line-height: 1.25;
  }
  .note__body h3 {
    margin: 1.9em 0 0.5em;
    line-height: 1.3;
  }

  /* rehype-autolink-headings wraps heading text in <a class="heading-anchor">.
     Keep those reading as plain headings (accent only on hover). */
  .note__body .heading-anchor {
    color: inherit;
    text-decoration: none;
  }
  .note__body .heading-anchor:hover {
    color: var(--accent);
  }

  /* Invisible section break — `---` becomes generous vertical air, no
     rule, same as the essay. */
  .note__body hr {
    border: 0;
    height: 0;
    margin: 3.25em 0 3em;
    background: transparent;
  }

  .note__body blockquote {
    margin: 1.8em 0;
    padding: 0.2em 0 0.2em 1.4em;
    border-left: 2px solid var(--border);
    font-style: italic;
    color: var(--text-muted);
  }
  .note__body blockquote p:last-child {
    margin-bottom: 0;
  }

  .note__body ul,
  .note__body ol {
    margin: 0 0 1.4em 0;
    padding-left: 1.4em;
  }
  .note__body li {
    margin-bottom: 0.4em;
  }
  .note__body li > p {
    margin: 0 0 0.4em 0;
  }
  .note__body ol > li::marker,
  .note__body ul > li::marker {
    color: var(--text-muted);
  }

  /* Inline code (block-code styling deferred, as on the essay). */
  .note__body :not(pre) > code {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text);
  }

  /* ─── Display maths (`$$…$$`) ──────────────────────────────────────
     rehype-katex renders block maths as <span class="katex-display">, a
     direct child of .note__body. Two deliberate choices, recorded as
     divergences (§1.11):

       1. CAPPED at the prose measure, not the wider breakout column —
          display equations belong WITH the text; the right-hand space is
          reserved for figures (Phase 4), not equations.
       2. LEFT-ANCHORED, not centred (KaTeX's default). The whole note
          column is left-anchored, so equations align to the prose's left
          edge rather than floating centre. This also makes the overflow
          predictable: KaTeX never wraps a line, so a too-wide equation
          starts at the left and scrolls RIGHT inside its own box (never
          the page), and the right-edge fade below correctly marks "there
          is more this way." The fade shows ONLY when content overflows.

     On narrow screens a mild size step-down lets most equations fit with
     no scroll at all. */
  .note__body .katex-display {
    max-width: var(--note-measure);
    margin: 1.8em 0;
    text-align: left;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    /* Right-edge scroll-shadow, on only while overflowing: a cover strip in
       the page background painted in LOCAL coordinates (it travels with the
       content and hides the shadow once you've scrolled to the end) sits
       over a translucent ink shadow in SCROLL coordinates (shown while the
       content runs past the right edge). Keyed to --bg / --text so it reads
       in both themes. */
    background:
      linear-gradient(to left, var(--bg), transparent) right center / 2.75rem 100% no-repeat local,
      radial-gradient(farthest-side at 100% 50%, color-mix(in srgb, var(--text) 16%, transparent), transparent) right center / 0.9rem 100% no-repeat scroll;
  }
  @media (max-width: 600px) {
    /* Mild step-down on phones so most display equations fit without a
       scroll. VISUAL TUNABLE. */
    .note__body .katex-display {
      font-size: 0.9em;
    }
  }


  .note__body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2.2em 0;
    border-radius: 2px;
  }

  /* ─── Cross-reference links (<Ref>) ────────────────────
     Calmer than the essay body's accent-at-rest links (§5). At rest the
     text stays in the body colour with a QUIET underline (muted, thin, set
     a little below the baseline so it reads as "this is a link" without
     shouting); on hover/focus both the text and the underline move to the
     accent. A <Ref> whose term is not yet in the registry renders as
     .note-ref--pending — plain text, no underline, no link — so a note can
     point forward to a topic that has not been written yet. */
  .note__body .note-ref {
    color: inherit;
    text-decoration: none;
    /* A border-bottom (not text-decoration underline): the underline must
       run under the WHOLE link, including a KaTeX symbol like the σ in
       "σ-algebra". KaTeX renders that σ in a display:inline-block .katex
       span, and a text-decoration underline is NOT drawn through atomic
       inline-level boxes, so it would skip the σ and underline only
       "-algebra". A border on the anchor's inline box passes continuously
       beneath inline-block children, so it covers the whole link. Muted and
       thin at rest so it does not shout. */
    border-bottom: 1px solid var(--text-muted);
    transition: color 150ms ease, border-color 150ms ease;
  }
  .note__body .note-ref:hover,
  .note__body .note-ref:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .note__body .note-ref--pending {
    color: inherit;
  }

  /* ─── Natural highlight box (<Boxed>) ──────────────────
     A hand-drawn, non-rectangular outline drawn as a CSS border-image
     (9-slice) from an inline SVG — zero JS. Every box is drawn in the
     ACCENT colour (matching the "help me learn" kicker), so a boxed idea
     reads as highlighted.

     There are 6 shape VARIANTS (.boxed--v1 … .boxed--v6). They share the
     same core — the same rounded-rect geometry, the same gentle
     low-frequency waver, the same corner treatment — and differ only in the
     specific wobbles, the way real hand-drawn boxes from one hand differ
     stroke to stroke. v1 is the original. Boxed.astro picks a variant per
     box by hashing the box's content at build time, so a given box always
     gets the same variant (deterministic, stable across rebuilds) while
     different boxes almost always differ. Adding/removing a variant is a
     matched pair of rules here plus a bump to VARIANT_COUNT in Boxed.astro.

     border-image can't take currentColor or a CSS var, so each variant bakes
     the accent stroke into its SVG and swaps to the dark-accent copy under
     :root.dark. `repeat: stretch` (NOT round) keeps a single confident pen
     line rather than a periodic scallop; the slice (38 of the 120 viewBox)
     keeps the whole corner inside the corner tile so only the straight
     middle stretches.

     Sizing: a 2px transparent border reserves the nominal line thickness;
     border-image-width 16px draws the sketch thicker than the border,
     reaching inward into the padding, so the padding keeps text clear of the
     line. Capped at the prose measure (§1.9); --note-wide is available if a
     box ever needs the breakout column. */
  .note__body .boxed {
    max-width: var(--note-measure);
    margin: 1.9em 0;
    padding: 1.2rem 1.5rem;
    border: 2px solid transparent;
    border-image-slice: 38;
    border-image-width: 16px;
    border-image-repeat: stretch;
  }
