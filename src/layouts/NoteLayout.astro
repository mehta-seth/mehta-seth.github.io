---
// src/layouts/NoteLayout.astro
//
// Layout for a "help me learn" note (HML). Phase 1 of the HML build:
// this establishes the PAGE SHAPE only —
//   - the same chrome as the essay/cities pages (wordmark top-left, fixed
//     theme toggle top-right), reusing BaseLayout, Wordmark, ThemeToggle
//     unchanged;
//   - a wider, LEFT-ANCHORED content column (not centred like the essay);
//   - the "help me learn" kicker sitting above a bold topic title;
//   - the note-body typography.
//
// Arriving in later phases (hooks/space reserved and commented here):
//   - Phase 2: KaTeX math (`$…$` / `$$…$$`) + the handwritten kicker font
//     + the topic title rendered from `titleDisplay` so the σ in
//     "σ-Algebras" is a real math glyph.
//   - Phase 3: the collapsible table of contents (hamburger in the left
//     gutter), the natural (non-rectangular) highlight box, and
//     cross-reference links.
//   - Phase 4: figures / lightbox for notes.
//
// The essay layout is deliberately NOT touched — this is a separate layout
// with its own widths and its own body namespace (.note__body). Note also
// that this file writes the serif stack out literally and never references
// var(--font-serif): that custom property is undefined project-wide and
// survives in EssayLayout only by inheritance, so it is not carried here.

import BaseLayout from './BaseLayout.astro';
import Wordmark from '@/components/Wordmark.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  /** Plain-text title — tab, OG, SEO, and the Phase-1 H1. */
  title: string;
  /** Optional math-bearing display title for the H1 (rendered from Phase 2). */
  titleDisplay?: string;
  /** One-line SEO description. Not displayed. */
  summary?: string;
  date: Date;
  updated?: Date;
  /** Heading tree from render() — passed through for the ToC (Phase 3). */
  headings: MarkdownHeading[];
  /** Per-note OG image; falls back to the site default in BaseLayout. */
  cover?: string;
}

// Phase 1 destructures only what it renders. `titleDisplay` (the H1 math
// glyph, Phase 2) and `headings` (the collapsible ToC, Phase 3) are
// declared on the Props interface and received from the route, but not
// consumed yet — each later phase pulls the one it needs.
const { title, summary, date, updated, cover } = Astro.props;

const stamp = updated ?? date;
const formattedDate = stamp.toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});
const isoDate = stamp.toISOString();
const dateLabel = updated ? 'Updated' : 'Published';

// Browser-tab title mirrors the essay convention.
const headTitle = `${title} — Adit Mehta`;
// Prefer the author's summary as the meta description; fall back to a
// substantive default so the SEO snippet is never thin.
const headDescription = summary
  ? summary
  : `${title}: an intuitive, one-page explanation. A help-me-learn note by Adit Mehta.`;
---

<BaseLayout
  title={headTitle}
  description={headDescription}
  ogType="article"
  ogImage={cover}
>
  <ThemeToggle />

  {/* Chrome — wordmark top-left; the fixed theme toggle floats over the
      right from global.css. padding-right on the header keeps the
      wordmark clear of the toggle on narrow viewports, same as the essay
      and cities headers. */}
  <header class="note-header" id="top">
    <Wordmark href="/" size="small" />
  </header>

  <div class="note-shell">
    <article class="note">
      {/* PHASE 3: the collapsible-ToC hamburger button lands in the left
          gutter of this article, vertically aligned to the left of the
          title. The gutter (padding-left on .note at ≥1024px) is
          reserved for it now so nothing reflows when it arrives. */}
      <header class="note-head">
        {/* Kicker — constant on every note. PHASE 1 PLACEHOLDER styling
            (Newsreader italic, muted); Phase 2 swaps the font-family to
            the chosen handwritten face and tunes size/colour. It is a
            <p>, not a heading, so it never competes with the H1 for SEO. */}
        <p class="note-kicker">help me learn</p>
        {/* Topic title = the page's H1 (keyword-bearing). Phase 2 renders
            `titleDisplay` here via KaTeX for the σ glyph. */}
        <h1 class="note-title">{title}</h1>
        <p class="note-date">
          <span class="note-date__label">{dateLabel}</span>
          {' '}
          <time datetime={isoDate}>{formattedDate}</time>
        </p>
      </header>

      {/* MDX body. Flowing prose is capped at a readable measure; wide
          elements (equations, highlight boxes, figures — later phases)
          break out toward the full column width. */}
      <div class="note__body">
        <slot />
      </div>

      <footer class="note-foot">
        <a href="#top" class="note-backtotop">↑ Back to top</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  /* ─── Chrome ──────────────────────────────────────────────────────
     Identical to EssayLayout's .essay-header (80rem centred box, 1.5rem
     left padding, 4.5rem right to clear the fixed toggle). Matching the
     rule exactly means the wordmark lands in the same position, and at
     the same size, as on the essay — at every viewport width. */
  .note-header {
    display: flex;
    align-items: baseline;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 1.5rem 0;
    padding-right: 4.5rem;
  }

  /* ─── Shell + article ─────────────────────────────────────────────
     Same 80rem centred box as the header, so the whole page sits where
     the essay does: a real left margin on wide screens, not hugging the
     edge. The note CONTENT is then indented ~4.5rem past the wordmark by
     the shell's left padding (1.5rem wordmark inset + 4.5rem gutter =
     6rem content inset), which also reserves room for the collapsible-ToC
     hamburger (Phase 3). The reading margin lands at roughly half the
     essay's across normal desktop widths — these are explainers, so they
     use more of the page while still reading comfortably. The space this
     leaves on the RIGHT is deliberate: figures and charts go there
     (Phase 4).

     Width knobs on .note:
       --note-measure  readable prose width (flowing text is capped here)
       --note-wide     breakout width for figures / equations / boxes,
                       reaching into the right-hand space
     Both are one-line tunables. */
  .note-shell {
    max-width: 80rem;
    margin-inline: auto;
    padding: 2.5rem 1.5rem 8rem;   /* mobile: content aligns with wordmark */
  }
  .note {
    --note-measure: 50rem;
    --note-wide: 66rem;
  }

  @media (min-width: 1024px) {
    /* Content indents to a 6rem left inset (4.5rem past the 1.5rem
       wordmark inset). The right padding keeps a small gutter before the
       page edge; the figure space is what's left between the ~50rem prose
       and the ~72rem content box. */
    .note-shell { padding: 3.5rem 2rem 9rem 6rem; }
  }

  /* ─── Note head ───────────────────────────────────────────────────*/
  .note-head {
    max-width: var(--note-measure);
    margin-bottom: 2.5rem;
  }
  .note-kicker {
    font-family: 'Newsreader', 'Charter', 'Georgia', serif;
    font-style: italic;
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    color: var(--text-muted);
    letter-spacing: 0.01em;
    line-height: 1.2;
    margin: 0 0 0.35rem 0;
  }
  .note-title {
    font-family: 'Newsreader', 'Charter', 'Georgia', serif;
    font-size: clamp(2.25rem, 1.85rem + 1.9vw, 3.25rem); /* ~36→52 */
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    margin: 0 0 0.75rem 0;
  }
  .note-date {
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin: 0;
  }
  .note-date__label {
    font-style: italic;
  }

  /* ─── Footer ──────────────────────────────────────────────────────*/
  .note-foot {
    max-width: var(--note-measure);
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .note-backtotop {
    font-size: var(--fs-small);
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .note-backtotop:hover,
  .note-backtotop:focus-visible {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>

<style is:global>
  /* ─── Note body typography (global because MDX-rendered) ───────────
     Scoped styles don't reach into <Content /> output, so the body rules
     live here, namespaced under .note__body so they never touch the home,
     cities, or essay pages.

     Two-tier width: flowing PROSE (paragraphs, headings, lists, quotes) is
     capped at the readable measure; WIDE elements (equations, highlight
     boxes, figures — later phases) are left uncapped so they can use the
     full breakout column. This keeps text comfortably readable while
     reserving the maximum width for the maths. */
  .note__body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Cap flowing prose to the readable measure (inherited from .note). */
  .note__body > p,
  .note__body > ul,
  .note__body > ol,
  .note__body > blockquote,
  .note__body > h2,
  .note__body > h3 {
    max-width: var(--note-measure);
  }

  .note__body p {
    margin: 0 0 1.4em 0;
  }

  /* Headings inherit family/weight/size from the global h2/h3 rules in
     global.css; only rhythm and line-height are tuned here. */
  .note__body h2 {
    margin: 2.5em 0 0.6em;
    line-height: 1.25;
  }
  .note__body h3 {
    margin: 1.9em 0 0.5em;
    line-height: 1.3;
  }

  /* rehype-autolink-headings wraps heading text in <a class="heading-anchor">.
     Keep those reading as plain headings (accent only on hover). */
  .note__body .heading-anchor {
    color: inherit;
    text-decoration: none;
  }
  .note__body .heading-anchor:hover {
    color: var(--accent);
  }

  /* Invisible section break — `---` becomes generous vertical air, no
     rule, same as the essay. */
  .note__body hr {
    border: 0;
    height: 0;
    margin: 3.25em 0 3em;
    background: transparent;
  }

  .note__body blockquote {
    margin: 1.8em 0;
    padding: 0.2em 0 0.2em 1.4em;
    border-left: 2px solid var(--border);
    font-style: italic;
    color: var(--text-muted);
  }
  .note__body blockquote p:last-child {
    margin-bottom: 0;
  }

  .note__body ul,
  .note__body ol {
    margin: 0 0 1.4em 0;
    padding-left: 1.4em;
  }
  .note__body li {
    margin-bottom: 0.4em;
  }
  .note__body li > p {
    margin: 0 0 0.4em 0;
  }
  .note__body ol > li::marker,
  .note__body ul > li::marker {
    color: var(--text-muted);
  }

  /* Inline code (block-code styling deferred, as on the essay). */
  .note__body :not(pre) > code {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    padding: 0.1em 0.35em;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--text);
  }

  /* Bare images — the Figure component (a later phase) adds wide/full
     breakout variants. */
  .note__body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2.2em 0;
    border-radius: 2px;
  }
</style>
