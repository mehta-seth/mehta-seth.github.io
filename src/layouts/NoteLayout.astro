  /* A display equation inside a box fills the box and drops the base rule's
     outer margin, but KEEPS the inherited horizontal-scroll + right-edge
     fade + narrow-screen step-down from the .katex-display rule above (this
     selector only overrides max-width and margin), so a wide equation still
     scrolls inside the box on a phone instead of stretching it. */
  .note__body .boxed .katex-display {
