---
// src/pages/learn/[...slug].astro
//
// Dynamic route for the `notes` collection ("help me learn"). Any
// .md/.mdx under src/content/notes/ becomes /learn/<slug>/ with no extra
// code — the same pattern as the essays route.
//
// URL base is /learn/ (not /help-me-learn/): short, readable, and
// keyword-relevant ("learn <topic>"), which is the SEO-preferred shape.
// The rest param [...slug] also allows nested paths later (e.g.
// src/content/notes/stochastic-processes/foo.mdx → /learn/stochastic-processes/foo/)
// with no change here.

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import NoteLayout from '@/layouts/NoteLayout.astro';
import Boxed from '@/components/Boxed.astro';
import Ref from '@/components/Ref.astro';
import Figure from '@/components/Figure.astro';

export async function getStaticPaths() {
  // Drafts are excluded from the production build (same rule as essays).
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

// MDX-callable components for notes. Phase 3 added <Boxed> (the hand-drawn
// highlight box) and <Ref> (cross-reference links); Phase 4 adds <Figure>
// (the shared responsive photograph/diagram component, generalised to the
// note body, with its click-to-zoom lightbox rendered once by NoteLayout).
// Authors use all of these in note MDX without importing them.
---

<NoteLayout
  title={note.data.title}
  titleDisplay={note.data.titleDisplay}
  summary={note.data.summary}
  date={note.data.date}
  updated={note.data.updated}
  cover={note.data.cover}
  headings={headings}
>
  <Content components={{ Boxed, Ref, Figure }} />
</NoteLayout>
